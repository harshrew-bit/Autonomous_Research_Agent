%% Autonomous Research Agent - System Architecture
%% Landscape Flowchart: Ingestion -> Execution -> Safe Tools -> Evaluation & Recovery -> Evidence & Synthesis

flowchart LR
    %% Theme Classes
    classDef inputStyle fill:#1e293b,stroke:#3b82f6,stroke-width:2px,color:#f8fafc;
    classDef llmStyle fill:#1e1b4b,stroke:#8b5cf6,stroke-width:2px,color:#e0e7ff;
    classDef loopStyle fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#e0f2fe;
    classDef toolStyle fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#d1fae5;
    classDef evalStyle fill:#4c0519,stroke:#f43f5e,stroke-width:2px,color:#ffe4e6;
    classDef replanStyle fill:#78350f,stroke:#f59e0b,stroke-width:2px,color:#fef3c7;
    classDef pipeStyle fill:#042f2e,stroke:#14b8a6,stroke-width:2px,color:#ccfbf1;
    classDef stateStyle fill:#312e81,stroke:#a855f7,stroke-width:2px,color:#f3e8ff;
    classDef outStyle fill:#14532d,stroke:#22c55e,stroke-width:2px,color:#dcfce7;
    classDef haltStyle fill:#7f1d1d,stroke:#ef4444,stroke-width:2px,color:#fee2e2;

    %% 1. Ingestion & Planning
    subgraph S_PLAN ["1. Ingestion & Planning"]
        CLI["USER / CLI Entry\napp/main.py\nResearch Query & Flags"]:::inputStyle
        AG["Node: analyze_goal\nGemini 3.5 Flash-Lite\nGoalAnalysis Schema"]:::llmStyle
        GP["Node: generate_plan\nGemini 3.5 Flash-Lite\nLLMPlan Schema"]:::llmStyle
        ADP["Plan Adapter\nClosed Schema -> Plan/Task\n0 additionalProperties"]:::llmStyle
    end

    %% 2. Execution & Safe Tools
    subgraph S_EXEC ["2. Execution & Safe Tools Layer"]
        EX["Node: execute_step\napp/agent/executor.py\nResolve Tool Call"]:::loopStyle
        TR["Tool Registry\napp/tools/registry.py\nWhitelist & Pydantic Guard"]:::toolStyle
        WS["web_search Tool\nTavily API (Live)\nMock Provider (Fault Sim)"]:::toolStyle
        PF["page_fetcher Tool\nSSRF Firewall Guard\nBeautifulSoup (2MB Cap)"]:::toolStyle
        OBS["Observation Container\nStructured Tool Observation"]:::loopStyle
    end

    %% Central State Bus
    STATE[("Central State Bus: ResearchAgentState\nsearch_results | fetched_pages | visited_urls\nevidence_items | step_count | retry_count | history")]:::stateStyle

    %% 3. Evaluation & Control Loop
    subgraph S_EVAL ["3. Evaluation & Recovery"]
        EV{"Node: evaluate_step\napp/agent/evaluator.py\nDecision Engine"}:::evalStyle
        RP["Node: replan_research\nGemini 3.5 Flash-Lite\nRevised LLM Plan"]:::replanStyle
        HALT["Terminate Safely\n(Step Limit >= 10)"]:::haltStyle
    end

    %% 4. Evidence Pipeline & Output
    subgraph S_SYNTH ["4. Evidence & Synthesis"]
        EP["Node: process_evidence\nRelevance (density >= 0.30)\nSHA-256 + Jaccard >= 0.75"]:::pipeStyle
        SR["Node: synthesize_report\nGemini 3.5 Flash-Lite\nGrounded Citations"]:::llmStyle
        OUT["Final Research Report\nreports/<query_slug>.md"]:::outStyle
    end

    %% Ingestion Flow
    CLI -->|"query string"| AG
    AG -->|"GoalAnalysis"| GP
    GP -->|"LLMPlan"| ADP
    ADP -->|"Plan / Task"| EX

    %% Execution & Tools Flow
    EX -->|"dispatch"| TR
    TR -->|"validate"| WS
    TR -->|"validate"| PF
    WS -->|"SearchResponse"| OBS
    PF -->|"FetchedPage"| OBS
    OBS -->|"last_observation"| EV

    %% State Synchronization
    EX <-.-> STATE
    OBS -.-> STATE
    EV <-.-> STATE
    RP -.-> STATE
    EP <-.-> STATE

    %% Evaluator Decision Branches
    EV -->|"CONTINUE: task succeeded"| EX
    EV ==>|"RETRY: timeout/429 (retry < 2)"| EX
    EV ==>|"REPLAN: 404/empty/exhausted"| RP
    RP -->|"revised plan -> execute"| EX
    EV -->|"FAIL: step limit >= 10"| HALT
    EV -->|"COMPLETE: all tasks done"| EP

    %% Synthesis Flow
    EP -->|"verified evidence"| SR
    SR -->|"ResearchReport"| OUT
